# Local development environment.
#
# Loaded by `next dev` (see https://nextjs.org/docs/app/api-reference/config/next-config-js/env).
# Targets the backend running directly on the developer machine via
# `dotnet run --project src/backend/Api`, which binds to:
#   - http://localhost:5180  (default http profile)
#   - https://localhost:7088 (https profile)
# Keep this in sync with src/backend/Api/Properties/launchSettings.json.
NEXT_PUBLIC_API_URL=http://localhost:5180
