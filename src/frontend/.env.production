# Production build environment.
#
# Loaded by `next build` (used by `pnpm build` inside Dockerfile.frontend).
# Targets the backend container published by compose.yaml as
# `8080:8080`, so the host-browser reaches it at http://localhost:8080.
#
# This file does NOT contain secrets: `NEXT_PUBLIC_*` values are inlined
# into the static bundle and are visible to anyone fetching the page.
# Backend-only secrets (JWT signing key, SQL Server password, ...) must
# live in environment variables consumed by the backend container only.
NEXT_PUBLIC_API_URL=http://localhost:8080
