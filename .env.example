# Password for the SQL Server `sa` login. Must satisfy SQL Server's password
# policy:
#   - At least 8 characters long.
#   - Contains characters from at least three of these four categories:
#     uppercase letter, lowercase letter, digit, non-alphanumeric symbol.
# This file is committed to the repository and is consumed by docker-compose.
# Replace the value below with a strong development password before bringing
# the stack up. Never reuse the value below in any non-development environment.
SA_PASSWORD=YourStrong!Passw0rd

# Base URL the frontend (running in the browser) uses to reach the backend.
# Must match the host port the `backend` service publishes in `compose.yaml`.
# The default below targets the Docker Compose stack (`backend: 8080:8080`).
# When running the backend directly with `dotnet run`, override to
# `http://localhost:5180` (see src/backend/Api/Properties/launchSettings.json).
NEXT_PUBLIC_API_URL=http://localhost:8080

# JWT signing key used by the backend inside the container.
# Must be at least 32 characters long. The default below is a dev-only
# placeholder; override it in any non-development environment.
JWT_SECRET_KEY=DEV_ONLY_DO_NOT_USE_IN_PRODUCTION_1234567890ABCDEF

# JWT issuer and audience. Defaults are appropriate for the local
# container stack; override them when deploying to other environments.
JWT_ISSUER=SB.Api
JWT_AUDIENCE=SB.Client

# JWT lifetime in minutes.
JWT_EXPIRATION_MINUTES=60
