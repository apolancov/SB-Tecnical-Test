# Build stage
FROM node:22-alpine AS build

ARG NEXT_PUBLIC_API_URL

WORKDIR /app

RUN corepack enable

# Copy package files and lockfile so `pnpm install --frozen-lockfile`
# can resolve every dependency declared by the Next.js + Vitest setup.
COPY src/frontend/package.json src/frontend/pnpm-lock.yaml ./

RUN pnpm install --frozen-lockfile

COPY src/frontend/ .

# `output: 'export'` in `next.config.mjs` produces a fully static
# `out/` directory that can be served by any HTTP static server.
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

RUN pnpm build

# Production stage.
#
# A minimal Node.js static server (`server.mjs`) ships with the
# repository and is the only thing that runs in the final image —
# nginx is not used.
FROM node:22-alpine AS runtime

WORKDIR /app

COPY --from=build /app/out ./out
COPY src/frontend/server.mjs ./server.mjs

ENV PORT=3000
ENV HOST=0.0.0.0

EXPOSE 3000

CMD ["node", "server.mjs"]
